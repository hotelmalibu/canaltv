# Puerto del servidor
PORT=3000

# Clave para firmar los tokens (cámbiala por una larga y aleatoria en producción)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Contraseña del usuario administrador (solo se usa la primera vez, al crear la BD)
ADMIN_PASSWORD=hotel123

# Clave de servicio para integraciones (MarketingPro IA publica videos con ella).
# Mínimo 24 caracteres, aleatoria. Si se deja vacía, la integración queda desactivada.
SERVICE_API_KEY=
